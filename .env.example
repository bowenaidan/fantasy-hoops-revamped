# Next.js app (copy to .env.local, which is gitignored).
# Read on the server only, so Supabase never has to be reachable from outside your
# network: only the Next.js app does. Use the self-hosted Supabase gateway (Kong).
SUPABASE_URL=http://supabase-vm.lan:8000
SUPABASE_ANON_KEY=

# Edge function secrets do NOT go here. Set them on the `functions` service in the
# self-hosted Supabase docker-compose.yml (see docs/deploy-proxmox.md):
#   ODDS_API_KEY, NCAA_API_BASE (optional)
