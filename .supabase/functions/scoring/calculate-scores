import { serve } from "https://deno.land/std@0.224.0/http/server.ts";
import {
  fetchDayGames,
  getDefaultSeasonStartDatePath,
  getHawaiiDatePath,
  isValidDatePath,
  nextDatePath,
  type NormalizedGame,
} from "./get-games";

type TierKey = "highMajor" | "highMid" | "trueMid" | "lowMajor";

type ScoringRequest = {
  range?: "today" | "season";
  startDate?: string;
  endDate?: string;
};

const CONFERENCE_TIER_MAP: Record<string, TierKey> = {
  acc: "highMajor",
  "big-12": "highMajor",
  "big-ten": "highMajor",
  sec: "highMajor",
  "big-east": "highMajor",
  "mountain-west": "highMid",
  "atlantic-10": "highMid",
  wcc: "highMid",
  american: "highMid",
  mvc: "trueMid",
  cusa: "trueMid",
  "ivy-league": "trueMid",
  "big-west": "trueMid",
  socon: "trueMid",
  caa: "trueMid",
  "sun-belt": "trueMid",
  mac: "trueMid",
  wac: "lowMajor",
  "big-south": "lowMajor",
  "big-sky": "lowMajor",
  southland: "lowMajor",
  horizon: "lowMajor",
  "summit-league": "lowMajor",
  maac: "lowMajor",
  asun: "lowMajor",
  ovc: "lowMajor",
  patriot: "lowMajor",
  "america-east": "lowMajor",
  swac: "lowMajor",
  meac: "lowMajor",
  nec: "lowMajor",
};

const CONF_POINTS: Record<TierKey, { home: number; road: number }> = {
  highMajor: { home: 3.5, road: 5 },
  highMid: { home: 2.5, road: 4 },
  trueMid: { home: 1.5, road: 2.5 },
  lowMajor: { home: 1, road: 1.5 },
};

function getConferenceTier(seo?: string | null): number | null {
  if (!seo) return null;
  const tier = CONFERENCE_TIER_MAP[seo.toLowerCase()];
  switch (tier) {
    case "highMajor":
      return 3;
    case "highMid":
      return 2;
    case "trueMid":
      return 1;
    case "lowMajor":
      return 0;
    default:
      return null;
  }
}

function normalizeRank(rank: number | string | null | undefined): number | null {
  if (rank === "" || rank === null || typeof rank === "undefined") return null;
  const parsed = Number(rank);
  return Number.isFinite(parsed) ? parsed : null;
}

function calculateGamePoints(game: NormalizedGame, winnerIsHome: boolean): number {
  const homeConference = game.home?.conferenceSeo?.toLowerCase() ?? null;
  const awayConference = game.away?.conferenceSeo?.toLowerCase() ?? null;
  const loserRank = winnerIsHome ? normalizeRank(game.away?.rank) : normalizeRank(game.home?.rank);

  let gamePoints = 0;

  if (homeConference && awayConference && homeConference === awayConference) {
    const tierKey = CONFERENCE_TIER_MAP[homeConference];
    if (tierKey) {
      gamePoints = CONF_POINTS[tierKey][winnerIsHome ? "home" : "road"];
    }
  } else {
    const winnerConference = winnerIsHome ? homeConference : awayConference;
    const loserConference = winnerIsHome ? awayConference : homeConference;
    const winnerTier = getConferenceTier(winnerConference);
    const loserTier = getConferenceTier(loserConference);
    const normalizedWinnerTier = winnerTier ?? -1;
    const normalizedLoserTier = loserTier ?? -1;
    const confDiff = normalizedLoserTier - normalizedWinnerTier;

    if (confDiff + 1 > 0) {
      gamePoints = (confDiff + 1) * 2;
    }

    if (normalizedWinnerTier === -1) {
      gamePoints -= 4;
    }
  }

  if (loserRank !== null && loserRank <= 25) {
    gamePoints += loserRank <= 10 ? 5 : 2.5;
  }

  return gamePoints;
}

function json(status: number, body: unknown): Response {
  return new Response(JSON.stringify(body), {
    status,
    headers: {
      "content-type": "application/json; charset=utf-8",
    },
  });
}

function resolveDateRange(payload: ScoringRequest): { startDate: string; endDate: string } {
  const today = getHawaiiDatePath();
  const range = payload.range ?? "today";

  if (range === "today") {
    return { startDate: today, endDate: today };
  }

  const startDate = payload.startDate ?? getDefaultSeasonStartDatePath();
  const endDate = payload.endDate ?? today;

  if (!isValidDatePath(startDate) || !isValidDatePath(endDate)) {
    throw new Error("startDate and endDate must use YYYY/MM/DD.");
  }

  if (startDate > endDate) {
    throw new Error("startDate must be less than or equal to endDate.");
  }

  return { startDate, endDate };
}

async function fetchGamesForRange(startDate: string, endDate: string): Promise<Array<{ date: string; games: NormalizedGame[] }>> {
  const days: Array<{ date: string; games: NormalizedGame[] }> = [];
  for (let date = startDate; date <= endDate; date = nextDatePath(date)) {
    const games = await fetchDayGames(date);
    days.push({ date, games });
  }
  return days;
}

serve(async (req) => {
  if (req.method !== "POST") {
    return json(405, { error: "Method not allowed. Use POST." });
  }

  try {
    const payload = (await req.json()) as ScoringRequest;
    const { startDate, endDate } = resolveDateRange(payload ?? {});
    const dailyGames = await fetchGamesForRange(startDate, endDate);

    const dailyResults = dailyGames.map(({ date, games }) => {
      const scoredGames = games
        .map((game) => {
          const winnerIsHome = game.home.winner === true;
          const winnerIsAway = game.away.winner === true;

          if (!winnerIsHome && !winnerIsAway) {
            return {
              gameID: game.gameID,
              status: game.gameState,
              points: null,
              winnerIsHome: null,
            };
          }

          return {
            gameID: game.gameID,
            status: game.gameState,
            points: calculateGamePoints(game, winnerIsHome),
            winnerIsHome,
          };
        });

      const dayPoints = scoredGames.reduce((sum, game) => sum + (game.points ?? 0), 0);

      return {
        date,
        totalGames: games.length,
        totalPoints: dayPoints,
        games: scoredGames,
      };
    });

    const totalPoints = dailyResults.reduce((sum, day) => sum + day.totalPoints, 0);
    const totalGames = dailyResults.reduce((sum, day) => sum + day.totalGames, 0);

    return json(200, {
      range: startDate === endDate ? "today" : "season",
      startDate,
      endDate,
      totalDays: dailyResults.length,
      totalGames,
      totalPoints,
      days: dailyResults,
    });
  } catch (error) {
    return json(400, {
      error: "Failed to process scoring request.",
      details: error instanceof Error ? error.message : String(error),
    });
  }
});
