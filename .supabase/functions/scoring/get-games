const NCAA_API_BASE = "https://ncaa-api.henrygd.me";

export type TeamApi = {
  names?: { short?: string };
  rank?: number | string | null;
  score?: number | string | null;
  winner?: boolean;
  conferences?: Array<{ conferenceSeo?: string | null }>;
};

export type GameApi = {
  gameID?: string | number;
  startTimeEpoch?: number | string;
  contestClock?: string;
  currentPeriod?: string | number;
  gameState?: string;
  finalMessage?: string;
  home?: TeamApi;
  away?: TeamApi;
};

type ScoreboardResponse = {
  games?: Array<{ game?: GameApi } | GameApi>;
};

export type NormalizedGame = {
  gameID: string | number | null;
  startTimeEpoch: number | string | null;
  gameState: string | null;
  finalMessage: string | null;
  contestClock: string | null;
  currentPeriod: string | number | null;
  home: {
    name: string | null;
    rank: number | string | null;
    score: number | string | null;
    winner: boolean;
    conferenceSeo: string | null;
  };
  away: {
    name: string | null;
    rank: number | string | null;
    score: number | string | null;
    winner: boolean;
    conferenceSeo: string | null;
  };
};

function unwrapGame(wrapper: { game?: GameApi } | GameApi): GameApi {
  if ((wrapper as { game?: GameApi }).game) {
    return (wrapper as { game?: GameApi }).game as GameApi;
  }
  return wrapper as GameApi;
}

function normalizeGame(game: GameApi): NormalizedGame {
  return {
    gameID: game.gameID ?? null,
    startTimeEpoch: game.startTimeEpoch ?? null,
    gameState: game.gameState ?? null,
    finalMessage: game.finalMessage ?? null,
    contestClock: game.contestClock ?? null,
    currentPeriod: game.currentPeriod ?? null,
    home: {
      name: game.home?.names?.short ?? null,
      rank: game.home?.rank ?? null,
      score: game.home?.score ?? null,
      winner: game.home?.winner === true,
      conferenceSeo: game.home?.conferences?.[0]?.conferenceSeo ?? null,
    },
    away: {
      name: game.away?.names?.short ?? null,
      rank: game.away?.rank ?? null,
      score: game.away?.score ?? null,
      winner: game.away?.winner === true,
      conferenceSeo: game.away?.conferences?.[0]?.conferenceSeo ?? null,
    },
  };
}

function toDatePath(date: Date): string {
  return date.toISOString().slice(0, 10).replace(/-/g, "/");
}

export function getHawaiiDatePath(now = new Date()): string {
  const hawaiiOffsetMinutes = 600;
  const localTimestamp = now.getTime() - hawaiiOffsetMinutes * 60 * 1000;
  return toDatePath(new Date(localTimestamp));
}

export function getDefaultSeasonStartDatePath(now = new Date()): string {
  const year = now.getUTCMonth() >= 10 ? now.getUTCFullYear() : now.getUTCFullYear() - 1;
  return `${year}/11/01`;
}

export function isValidDatePath(date: string): boolean {
  return /^\d{4}\/\d{2}\/\d{2}$/.test(date);
}

export function nextDatePath(datePath: string): string {
  const normalized = datePath.replace(/\//g, "-");
  const date = new Date(`${normalized}T00:00:00.000Z`);
  date.setUTCDate(date.getUTCDate() + 1);
  return toDatePath(date);
}

export async function fetchDayGames(isoDatePath: string): Promise<NormalizedGame[]> {
  const url = `${NCAA_API_BASE}/scoreboard/basketball-men/d1/${isoDatePath}/all-conf`;
  const res = await fetch(url, { headers: { accept: "application/json" } });

  if (!res.ok) {
    throw new Error(`Upstream request failed (${res.status}) for ${isoDatePath}`);
  }

  let data: ScoreboardResponse;
  try {
    data = (await res.json()) as ScoreboardResponse;
  } catch {
    throw new Error(`Invalid JSON response for ${isoDatePath}`);
  }

  if (!Array.isArray(data.games)) {
    return [];
  }

  return data.games.map(unwrapGame).map(normalizeGame);
}